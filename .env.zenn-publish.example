# scripts/zenn-publish-apply.mjs 用の設定。
# このファイルを .env.zenn-publish にコピーして値を入れる（.env.zenn-publish は git 管理外）。

# Zenn のユーザー名（公開URL https://zenn.dev/<ZENN_USERNAME>/articles/<slug> の生成に使用）
ZENN_USERNAME=ykbone

# push 先ブランチ
ZENN_PUBLISH_BRANCH=main

# 記事申請フォーム
FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLSdMk1QZZejdMIQ01W0E0nzsK947gMlT3C4fvwwBkWmtya3L0g/viewform
FORM_EMAIL=yuichi.kobayashi@onewedge.co.jp
FORM_NAME=小林 勇一
FORM_APPLICATION_TYPE=新規申請

# Google ログイン。推奨は `npm run publish:apply -- login` による手動ログイン（プロファイルに保存）。
# パスワードを設定すると未ログイン時に自動ログインを試みる（2段階認証がある場合は --headed で手動対応）。
GOOGLE_ACCOUNT_EMAIL=yuichi.kobayashi@onewedge.co.jp
GOOGLE_ACCOUNT_PASSWORD=

# ログイン状態を保存するブラウザプロファイルの場所（既定: ~/.zenn-publish/chrome-profile）
# ZENN_PUBLISH_PROFILE_DIR=
# 使用するブラウザ（既定: chrome = インストール済み Google Chrome。空にすると Playwright 同梱 Chromium）
# ZENN_PUBLISH_BROWSER_CHANNEL=chrome
